{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Society Launcher",
  "version": "0.1.0",
  "identifier": "local.agentsociety.launcher",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/node"],
    "resources": { "../skins": "GUI/skins" },
    "shortDescription": "Agent Society 服务器引导启动器",
    "longDescription": "后台启动 Agent Society 服务器:托盘常驻、优雅关闭、无终端窗口。"
  }
}
