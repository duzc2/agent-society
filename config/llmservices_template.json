{
  "services": [
    {
      "id": "text-model",
      "name": "纯文本模型",
      "baseURL": "http://127.0.0.1:1234/v1",
      "model": "text-model-name",
      "apiKey": "NOT_NEEDED",
      "timeout": 1800000,
      "maxTokens": 4096,
      "capabilityTags": ["text", "tool_calling"],
      "capabilities": {
        "input": ["text"],
        "output": ["text", "structured_output", "tool_calling"]
      },
      "description": "纯文本对话模型，不支持多模态输入"
    },
    {
      "id": "vision-model",
      "name": "视觉理解模型",
      "baseURL": "http://127.0.0.1:1234/v1",
      "model": "vision-model-name",
      "apiKey": "NOT_NEEDED",
      "maxTokens": 2048,
      "capabilityTags": ["vision", "image_analysis", "multimodal"],
      "capabilities": {
        "input": ["text", "vision"],
        "output": ["text", "structured_output"]
      },
      "description": "支持图片理解的视觉模型"
    },
    {
      "id": "multimodal-model",
      "name": "多模态模型",
      "baseURL": "http://127.0.0.1:1234/v1",
      "model": "multimodal-model-name",
      "apiKey": "NOT_NEEDED",
      "maxTokens": 4096,
      "capabilityTags": ["multimodal", "vision", "audio", "file"],
      "capabilities": {
        "input": ["text", "vision", "audio", "file"],
        "output": ["text", "structured_output", "tool_calling"]
      },
      "description": "支持多种输入类型的全能模型"
    },
    {
      "id": "coding-model",
      "name": "编程模型",
      "baseURL": "http://127.0.0.1:1234/v1",
      "model": "coding-model-name",
