      "maxTokens": 8192,
      "capabilityTags": ["coding", "code_generation", "code_review"],
      "capabilities": {
        "input": ["text", "file"],
        "output": ["text", "structured_output", "tool_calling"]
      },
      "description": "专门用于代码生成和编程任务的模型，支持文件阅读"
    },
    {
      "id": "high-intelligence-model",
      "name": "高智能模型",
      "baseURL": "http://127.0.0.1:1234/v1",
      "model": "high-intelligence-model-name",
      "apiKey": "NOT_NEEDED",
      "maxTokens": 8192,
      "capabilityTags": ["high_intelligence", "complex_reasoning", "deep_analysis"],
      "capabilities": {
        "input": ["text"],
        "output": ["text", "structured_output", "tool_calling"]
      },
      "description": "适用于复杂推理和深度分析任务的高智能模型"
    },
    {
      "id": "low-cost-model",
      "name": "低成本模型",
      "baseURL": "http://127.0.0.1:1234/v1",
      "model": "low-cost-model-name",
      "apiKey": "NOT_NEEDED",
